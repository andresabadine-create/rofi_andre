* {
    background-color:   #302f30;
    border-color:       #eceff4;
    text-color:         #8f8f8f;
    font:               "Inconsolata Nerd Font Mono Bold 10";
}
window {
    anchor:     north;
    location:   north;
    width:      100%;
    padding:    4px;
    children:   [ horibox ];
}
horibox {
    orientation: horizontal;
    children:   [entry, listview];
}
listview {
    layout:     horizontal;
    spacing:    15px;
    lines:      4;
}
entry {
    expand:     false;
    width:      10em;
}
element {
    padding: 0px 2px;
}
element selected {
    background-color: #00000000;
    text-color: #ffffff;

    border:		0px 0px 1px 0px;
    border-color:	#a86f9c;
}
element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}
